BROWSERBASE_API_KEY=
# Search -> Fetch -> OpenAI ranking. No browser project or shopping login needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional for project-scoped Browserbase keys.
BROWSERBASE_PROJECT_ID=
# Optional legacy CONNECT flow: Fernet key to encrypt DoorDash credentials.
DOORDASH_CREDENTIAL_KEY=
# Local MongoDB default; replace with your MongoDB Atlas URI when ready.
MONGODB_URI=mongodb://localhost:27017
# The prototype accepts commands from this one private iMessage user only.
DEMO_USER_HANDLE=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Public HTTPS origin of this Flask app (or your development tunnel).
PUBLIC_BASE_URL=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
SIGN_IN_TIMEOUT_SECONDS=600
BROWSER_SESSION_TIMEOUT_SECONDS=900
MAX_BROWSER_SESSIONS=2
# Optional: enables the Stagehand search demo after login.
MODEL_API_KEY=
STAGEHAND_MODEL=
